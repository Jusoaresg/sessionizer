#!/usr/bin/env bash

# Use native fast scanning and string manipulation without subshells
CANDIDATES=$(
  # 1. Standard project and config folders
  find "$HOME/Projects" "$HOME/.config" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | while read -r dir; do
    # Native bash parameter expansion (instantaneous, no fork/basename/dirname)
    name="${dir##*/}"
    parent="${dir%/*}"
    parent_name="${parent##*/}"
    printf "%s/%s\t%s\n" "$parent_name" "$name" "$dir"
  done

  # 2. Worktrees only (direct path depth check, no glob expansion)
  find "$HOME/Projects" -mindepth 3 -maxdepth 3 -type d -path '*/.worktrees/*' 2>/dev/null | while read -r dir; do
    wt_name="${dir##*/}"
    dot_wt="${dir%/*}"
    repo_dir="${dot_wt%/*}"
    repo_name="${repo_dir##*/}"
    printf "Projects/%s [wt: %s]\t%s\n" "$repo_name" "$wt_name" "$dir"
  done
)

SELECTED_LINE=$(echo -e "$CANDIDATES" | fzf --delimiter='\t' --with-nth=1)

[[ -z "$SELECTED_LINE" ]] && exit 0

PROJECT="${SELECTED_LINE##*$'\t'}"

if [[ "$PROJECT" == *"/.worktrees/"* ]]; then
  WT_NAME="${PROJECT##*/}"
  TMP="${PROJECT%/*}"
  REPO_DIR="${TMP%/*}"
  PARENT_PROJ="${REPO_DIR##*/}"

  SESSION_NAME="wt_${PARENT_PROJ}__${WT_NAME}"
  IS_WORKTREE=true
elif [[ "$PROJECT" == *"$HOME/.config"* ]]; then
  DIR_NAME="${PROJECT##*/}"
  SESSION_NAME="cfg_${DIR_NAME//./_}"
  IS_WORKTREE=false
else
  DIR_NAME="${PROJECT##*/}"
  SESSION_NAME="${DIR_NAME//./_}"
  IS_WORKTREE=false
fi

EXACT_SESSION=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep -Fx "$SESSION_NAME")

if [ -n "$EXACT_SESSION" ]; then
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$SESSION_NAME"
  else
    exec tmux attach -t "$SESSION_NAME"
  fi
else
  tmux new-session -d -s "$SESSION_NAME" -n "term1" -c "$PROJECT"
  tmux new-window -t "${SESSION_NAME}:2" -n "editor" -c "$PROJECT" "nvim"
  tmux new-window -t "${SESSION_NAME}:3" -n "term2" -c "$PROJECT"
  tmux select-window -t "${SESSION_NAME}:2"

  if [ "$IS_WORKTREE" = true ]; then
    tmux set-option -t "$SESSION_NAME" status-style "bg=#d75f00,fg=#000000,bold"
    tmux set-option -t "$SESSION_NAME" status-left "  [WORKTREE: $WT_NAME] "
  fi

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$SESSION_NAME"
  else
    exec tmux attach -t "$SESSION_NAME"
  fi
fi
